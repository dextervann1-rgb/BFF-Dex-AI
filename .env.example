# BFFDex AI - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Wallet (Base chain private key for signing transactions)
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# ElevenLabs Voice Verification
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEXTER_VOICE_ID=your_elevenlabs_voice_id_here

# Ethereum Attestation Service (EAS) on Base
PAYMENT_SCHEMA_UID=your_eas_schema_uid_here

# QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret_here
QUICKBOOKS_REDIRECT_URI=https://your-domain.vercel.app/api/quickbooks/callback
