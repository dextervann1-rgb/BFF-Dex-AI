# BFFDex AI - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Wallet (Base chain private key for signing transactions)
# Keep transaction signing disabled until wallet custody, Base testnet rehearsal, and approval checks are complete.
BFFDEX_TRANSACTION_SIGNING_ENABLED=false
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Payment recipients must be supplied explicitly in each EIP-681 payment link.
# Do not configure a default recipient fallback for executable payments.

# ElevenLabs Voice Verification
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEXTER_VOICE_ID=your_elevenlabs_voice_id_here

# Ethereum Attestation Service (EAS) on Base
PAYMENT_SCHEMA_UID=your_eas_schema_uid_here

# QuickBooks OAuth (App credentials from Intuit Developer Portal)
QB_CLIENT_ID=your_quickbooks_client_id_here
QB_CLIENT_SECRET=your_quickbooks_client_secret_here
QB_REDIRECT_URI=https://your-domain.vercel.app/api/quickbooks/callback

# Supabase Configuration (for transaction persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# QuickBooks Runtime (populated after OAuth flow)
# NOTE: Tokens are now stored in Supabase automatically
# The following env vars are optional (used as fallback if Supabase is not configured)
QB_REALM_ID=your_quickbooks_realm_id_here
QB_ACCESS_TOKEN=your_quickbooks_access_token_here
QB_VENDOR_ID=your_quickbooks_vendor_id_here
QB_EXPENSE_ACCOUNT_ID=your_quickbooks_expense_account_id_here

# Cron Secret (for Vercel cron jobs)
CRON_SECRET=your_random_secret_here
